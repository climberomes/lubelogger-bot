[Unit]
Description=LubeLogger Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lubebot
WorkingDirectory=/opt/lubelogger-bot
EnvironmentFile=/opt/lubelogger-bot/.env
ExecStart=/opt/lubelogger-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
