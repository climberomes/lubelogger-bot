# ── Discord ────────────────────────────────────────────────────────────────────
# Create your bot at https://discord.com/developers/applications
# Enable: "applications.commands" scope + "bot" scope
DISCORD_TOKEN=your_discord_bot_token_here

# ── LubeLogger ─────────────────────────────────────────────────────────────────
# Internal URL to your LubeLogger instance (no trailing slash)
LUBELOGGER_URL=http://192.168.1.50:8080

# API Key from LubeLogger → Settings → API Keys → Generate
# Scope it to "Editor" (can add records, cannot delete)
# Leave blank only if your instance runs with no auth at all
LUBELOGGER_API_KEY=

# ── Optional: restrict /fuel to one Discord channel ────────────────────────────
# Right-click a channel → Copy Channel ID (enable Developer Mode in Discord settings)
ALLOWED_CHANNEL_ID=
